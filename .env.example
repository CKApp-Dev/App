# Copy this file to .env.local (gitignored) and fill in the real values for
# local development. Expo CLI loads .env.local automatically when it reads
# app.config.ts. Never commit .env.local.

# Taipei Metro API (api.metro.taipei) account for the 交通 page.
# Ask a maintainer for the current account.
METRO_API_USER=
METRO_API_PASS=

# Google Maps API key ("Maps SDK for Android") for the maps on Android.
# iOS uses Apple Maps and needs no key. Without it the Android maps are blank.
GOOGLE_MAPS_API_KEY=

# 1 adds the iOS 現在 widget at prebuild (a widget extension and the App Group
# group.org.capacitor.quasar.ckapp). Store builds need both registered in the
# Apple Developer account first, with a provisioning profile for the extension.
ENABLE_WIDGETS=

# Announcements default to the public configuration in config/firebase.public.json.
# Optional overrides for a separate Firebase environment:
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

# Optional Expo project UUID override (defaults to config/expo-project.json).
# Set up FCM v1 / APNs credentials for this EAS project before testing pushes.
EAS_PROJECT_ID=

# Optional Android SDK config override; defaults to config/google-services.json.
# Each build's package name needs a matching client (including .dev for debug).
GOOGLE_SERVICES_JSON=

# Local iOS builds use the APNs sandbox. Release CI sets production to match
# the distribution provisioning profile's aps-environment entitlement.
IOS_PUSH_ENVIRONMENT=development
