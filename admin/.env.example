# Copy the public Firebase web configuration from the new Firebase project.
# These browser values are public; never place service-account keys here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=

# Keep false for GitHub Pages/static hosts unless Firebase auth redirect helpers
# have been served/proxied on the same origin. Popup sign-in works by default.
VITE_FIREBASE_ENABLE_REDIRECT=false
